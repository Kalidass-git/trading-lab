{
  "appId": "com.tradinglab.app",
  "appName": "Trading Lab",
  "webDir": "www",
  "backgroundColor": "#f2f3f9",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#2b2a8c",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT"
    }
  }
}
